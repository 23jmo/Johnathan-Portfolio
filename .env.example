# Spotify API (optional - widget hidden if not configured)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Notion Blog CMS
NOTION_API_KEY=
NOTION_BLOG_DB_ID=

# YouTube Data API (used by the videos section + AI chat render_youtube tool)
YOUTUBE_API_KEY=

# Dedalus Labs (AI chat). Chat degrades gracefully if unset.
DEDALUS_API_KEY=
# Optional: override the model (default anthropic/claude-sonnet-4-6).
# NOTE: Dedalus ids are dash-separated — use claude-sonnet-4-6, not 4.6.
DEDALUS_MODEL=
